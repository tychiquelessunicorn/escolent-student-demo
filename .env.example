# Anthropic. Server-side only — this key must never reach client code, which is
# why every AI call goes through /api/ai or /api/distress rather than the browser.
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults are claude-haiku-4-5 for everything a
# student sees in the ordinary course of a session, and claude-opus-5 for the
# distress classifier, where accuracy outranks cost.
# ANTHROPIC_MODEL_DEFAULT=claude-haiku-4-5
# ANTHROPIC_MODEL_DISTRESS=claude-opus-5

# Upstash Redis. Rate-limit counters and escalation records only — not an
# application database. In production, /api/ai refuses traffic when these are
# missing rather than running unlimited against a low balance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared access phrase for the public demo. Unset disables the gate, which is
# fine locally and a misconfiguration in production.
DEMO_PASSWORD=
